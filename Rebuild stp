-- Création de la base de données
CREATE DATABASE IF NOT EXISTS gestion_capteurs;
USE gestion_capteurs;
-- Suppression des tables si elles existent déjà
DROP TABLE IF EXISTS Mesure;
DROP TABLE IF EXISTS mesurandes;
DROP TABLE IF EXISTS Capteurs;
DROP TABLE IF EXISTS `User`;
-- Table User
CREATE TABLE `User` (
    id_user INT AUTO_INCREMENT PRIMARY KEY,
    nom_User VARCHAR(100) NOT NULL,
    mdp_User VARCHAR(255) NOT NULL,
    autor_User VARCHAR(50) NOT NULL
);
-- Table Capteurs
CREATE TABLE Capteurs (
    num_Capteur INT AUTO_INCREMENT PRIMARY KEY,
    nom_Capteur VARCHAR(100) NOT NULL,
    emplacement VARCHAR(150)
);
-- Table mesurandes
CREATE TABLE mesurandes (
    num_Mesure INT AUTO_INCREMENT PRIMARY KEY,
    lib_Mesure VARCHAR(100) NOT NULL,
    unite_Mesurandes VARCHAR(50)
);
-- Table Mesure
CREATE TABLE Mesure (
    id_mesure INT AUTO_INCREMENT PRIMARY KEY,
    date_Mesure DATETIME NOT NULL,
    val_Mesure DECIMAL(10,2) NOT NULL,
    num_Capteur INT NOT NULL,
    num_Mesure INT NOT NULL,
    FOREIGN KEY (num_Capteur)
        REFERENCES Capteurs(num_Capteur),
    FOREIGN KEY (num_Mesure)
        REFERENCES mesurandes(num_Mesure)
);
